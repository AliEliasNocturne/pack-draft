{
  "name": "pack-draft",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @pack-draft/api dev",
    "dev:mobile": "pnpm --filter @pack-draft/mobile start",
    "ios": "pnpm --filter @pack-draft/mobile ios",
    "android": "pnpm --filter @pack-draft/mobile android",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @pack-draft/api db:migrate",
    "db:generate": "pnpm --filter @pack-draft/api db:generate",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm --filter @pack-draft/mobile format",
    "test": "pnpm -r --if-present test"
  }
}
